# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Iron Session (must be at least 32 characters)
SESSION_SECRET=change-this-to-a-random-32-chars-string

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@alvarado-vendedores.com

# Vercel Cron (secret to protect cron endpoints)
CRON_SECRET=your-cron-secret-here

# App URL
NEXT_PUBLIC_APP_URL=https://alvarado-vendedores.vercel.app
